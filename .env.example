# SANKALP AI — environment variables (NAMES ONLY — never commit real values).
# Copy to .env and fill in. The server refuses to start if required secrets are missing or weak.

NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=
CORS_ORIGINS=                      # comma-separated browser origins, e.g. https://sankalp.example.in
TRUST_PROXY=1                      # number of reverse-proxy hops in front of the server
DEMO_MODE=false                    # true only for demos (shows a DEMO badge everywhere)
DATA_DIR=./data                    # snapshot, uploads, private evidence, one-time codes

# Required secrets (>= 32 random characters each, and different from each other)
JWT_SECRET=
DEPT_JWT_SECRET=

# Optional one-time bootstrap of the first state administrator (unset after first boot)
BOOTSTRAP_SUPER_ADMIN_PHONE=
BOOTSTRAP_SUPER_ADMIN_PIN=

# Data residency (rule 1): only these hosts may receive outbound requests
EGRESS_ALLOWLIST=api.sarvam.ai,newsonair.gov.in,www.pib.gov.in   # AI + official news (Government of India); add your SMS/IVR provider host

# AI (§11 defaults: Sarvam if key set → self-hosted if URL set → rules engine)
AI_TEXT_PROVIDER=                  # sarvam | selfhosted | rules
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
DATAGOV_API_KEY=                   # data.gov.in key (free) — live mandi prices; add api.data.gov.in to EGRESS_ALLOWLIST
SARVAM_REASONING=none              # none (fast, default) | low | medium | high
SARVAM_VISION_MODEL=gemma4         # photo analysis on Sarvam /v2 (image input)
AI_VISION_PROVIDER=                # empty = Sarvam when SARVAM_API_KEY is set | selfhosted | off (manual review only)
AI_TEXT_BASE_URL=                  # OpenAI-compatible endpoint on Indian infrastructure (add its host to EGRESS_ALLOWLIST)
AI_TEXT_MODEL=
AI_VISION_BASE_URL=                # self-hosted vision model; without it photos go to manual review
AI_VISION_MODEL=

# Maps
MAP_TILE_URL=                      # empty = ISRO Bhuvan (Indian, default) · https://tiles.example.in/{z}/{x}/{y}.png · wms:<url>|<layer> · none

# Notifications (payloads never contain personal data)
PUSH_DRIVER=console                # none | console | expo (expo also requires exp.host in EGRESS_ALLOWLIST)
EXPO_ACCESS_TOKEN=

# Persistence
SNAPSHOT_INTERVAL_MS=30000

# Phase 1+ (not used yet)
DATABASE_URL=
STORAGE_DRIVER=snapshot            # snapshot | postgres
MEDIA_DRIVER=local                 # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
EVIDENCE_ENC_KEY=
SMS_DRIVER=console                 # console (dev log) | msg91 (MSG91, India; add control.msg91.com to EGRESS_ALLOWLIST) | dlt-http (generic DLT gateway)
MSG91_AUTH_KEY=                    # msg91: auth key from the MSG91 dashboard
SMS_TEMPLATE_IDS=                  # msg91: JSON {"otp":"<DLT template id>","status_update":"…"}; message types without an id are not sent
SMS_API_URL=                       # gateway endpoint for dlt-http
# Phase 3.5 confirmation channels. Inbound SMS replies ("1"/"2") are POSTed by your gateway to
# /api/verification/sms-inbound with header X-Webhook-Secret: <INBOUND_SMS_SECRET>. Empty = disabled.
INBOUND_SMS_SECRET=
# Voice callback (press 1/2): console (dev log) | ivr-http (Indian IVR provider; host must be in EGRESS_ALLOWLIST).
# PUBLIC_BASE_URL must be set so the provider can reach /api/verification/ivr/<signed token>.
VOICE_DRIVER=console
VOICE_API_URL=
VOICE_API_KEY=
SMS_API_KEY=
SMS_SENDER_ID=
DLT_ENTITY_ID=
# Phase 5.2/5.3 channels — see docs/CHANNELS.md
IVR_WEBHOOK_SECRET=
WHATSAPP_DRIVER=console
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
# Proof radius, weights and thresholds live in config/tenants/<state>.json → "verification" (P3).

# Mobile app build
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_API_URL=
