# SANKALP AI — environment variables (NAMES ONLY — never commit real values).
# Copy to .env and fill in. The server refuses to start if required secrets are missing or weak.

NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=
CORS_ORIGINS=                      # comma-separated browser origins, e.g. https://sankalp.example.in
TRUST_PROXY=1                      # number of reverse-proxy hops in front of the server
DEMO_MODE=false                    # true only for demos (shows a DEMO badge everywhere)
DATA_DIR=./data                    # snapshot, uploads, private evidence, one-time codes

# Required secrets (>= 32 random characters each, and different from each other)
JWT_SECRET=
DEPT_JWT_SECRET=

# Optional one-time bootstrap of the first state administrator (unset after first boot)
BOOTSTRAP_SUPER_ADMIN_PHONE=
BOOTSTRAP_SUPER_ADMIN_PIN=

# Data residency (rule 1): only these hosts may receive outbound requests
EGRESS_ALLOWLIST=api.sarvam.ai

# AI (§11 defaults: Sarvam if key set → self-hosted if URL set → rules engine)
AI_TEXT_PROVIDER=                  # sarvam | selfhosted | rules
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
AI_TEXT_BASE_URL=                  # OpenAI-compatible endpoint on Indian infrastructure (add its host to EGRESS_ALLOWLIST)
AI_TEXT_MODEL=
AI_VISION_BASE_URL=                # self-hosted vision model; without it photos go to manual review
AI_VISION_MODEL=

# Maps
MAP_TILE_URL=                      # e.g. https://tiles.example.in/{z}/{x}/{y}.png (OSM default only in development)

# Notifications (payloads never contain personal data)
PUSH_DRIVER=console                # none | console | expo (expo also requires exp.host in EGRESS_ALLOWLIST)
EXPO_ACCESS_TOKEN=

# Persistence
SNAPSHOT_INTERVAL_MS=30000

# Phase 1+ (not used yet)
DATABASE_URL=
STORAGE_DRIVER=snapshot            # snapshot | postgres
MEDIA_DRIVER=local                 # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
EVIDENCE_ENC_KEY=
SMS_DRIVER=console
SMS_API_KEY=
SMS_SENDER_ID=
DLT_ENTITY_ID=
VOICE_DRIVER=mock
VOICE_API_KEY=
WHATSAPP_DRIVER=mock
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
PROOF_RADIUS_M=50

# Mobile app build
EXPO_PUBLIC_DOMAIN=
EXPO_PUBLIC_API_URL=
